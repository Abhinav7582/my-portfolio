import { useEffect, useRef } from "react"

function NeuralBackground() {
  const canvasRef = useRef(null)
  const scrollProgress = useRef(0)

  useEffect(() => {
    const canvas = canvasRef.current
    const ctx = canvas.getContext("2d")
    let animationId
    let streams = []
    let time = 0

    const resize = () => {
      canvas.width = window.innerWidth
      canvas.height = window.innerHeight
    }

    const onScroll = () => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight
      scrollProgress.current = scrollable > 0 ? window.scrollY / scrollable : 0
    }

    const createStreams = () => {
      streams = []
      const count = 14
      for (let i = 0; i < count; i++) {
        streams.push({
          baseY: (canvas.height / count) * i + Math.random() * 40,
          amplitude: Math.random() * 40 + 20,
          frequency: Math.random() * 0.003 + 0.001,
          speed: Math.random() * 0.4 + 0.2,
          phase: Math.random() * Math.PI * 2,
          thickness: Math.random() * 1.2 + 0.4,
          opacity: Math.random() * 0.25 + 0.1,
          // particles flowing along the stream
          particles: Array.from({ length: 3 }, () => Math.random()),
        })
      }
    }

    const lerp = (a, b, t) => a + (b - a) * t

    const draw = () => {
      const p = scrollProgress.current
      time += 1

      // Background — deep navy, shifts slightly warmer/deeper as you scroll
      const bgTop = lerp(8, 14, p)
      const bg = ctx.createLinearGradient(0, 0, 0, canvas.height)
      bg.addColorStop(0, `rgb(${bgTop}, ${bgTop + 4}, ${bgTop + 14})`)
      bg.addColorStop(1, "#02030a")
      ctx.fillStyle = bg
      ctx.fillRect(0, 0, canvas.width, canvas.height)

      // Color shifts blue → cyan → indigo as you scroll
      const hue = lerp(210, 250, p) // 210 blue → 250 indigo
      const flowSpeed = 1 + p * 2 // streams flow faster deeper down

      streams.forEach((stream, idx) => {
        stream.phase += stream.speed * 0.01 * flowSpeed

        // Draw the flowing line
        ctx.beginPath()
        for (let x = 0; x <= canvas.width; x += 8) {
          const y =
            stream.baseY +
            Math.sin(x * stream.frequency + stream.phase) * stream.amplitude +
            Math.sin(x * stream.frequency * 2.3 + stream.phase * 1.5) * (stream.amplitude * 0.3)
          if (x === 0) ctx.moveTo(x, y)
          else ctx.lineTo(x, y)
        }
        const lineHue = hue + idx * 2
        ctx.strokeStyle = `hsla(${lineHue}, 80%, 65%, ${stream.opacity})`
        ctx.lineWidth = stream.thickness
        ctx.stroke()

        // Glowing particles flowing along the stream
        stream.particles.forEach((particlePos, pi) => {
          stream.particles[pi] += 0.002 * flowSpeed
          if (stream.particles[pi] > 1) stream.particles[pi] = 0

          const px = stream.particles[pi] * canvas.width
          const py =
            stream.baseY +
            Math.sin(px * stream.frequency + stream.phase) * stream.amplitude +
            Math.sin(px * stream.frequency * 2.3 + stream.phase * 1.5) * (stream.amplitude * 0.3)

          const glow = ctx.createRadialGradient(px, py, 0, px, py, 6)
          glow.addColorStop(0, `hsla(${lineHue}, 90%, 75%, ${stream.opacity * 3})`)
          glow.addColorStop(1, `hsla(${lineHue}, 90%, 75%, 0)`)
          ctx.beginPath()
          ctx.arc(px, py, 6, 0, Math.PI * 2)
          ctx.fillStyle = glow
          ctx.fill()

          ctx.beginPath()
          ctx.arc(px, py, 1.5, 0, Math.PI * 2)
          ctx.fillStyle = `hsla(${lineHue}, 90%, 85%, ${stream.opacity * 4})`
          ctx.fill()
        })
      })

      animationId = requestAnimationFrame(draw)
    }

    resize()
    createStreams()
    onScroll()
    draw()

    window.addEventListener("resize", () => {
      resize()
      createStreams()
    })
    window.addEventListener("scroll", onScroll, { passive: true })

    return () => {
      cancelAnimationFrame(animationId)
      window.removeEventListener("resize", resize)
      window.removeEventListener("scroll", onScroll)
    }
  }, [])

  return (
    <canvas
      ref={canvasRef}
      className="fixed inset-0 z-0 pointer-events-none"
    />
  )
}

export default NeuralBackground